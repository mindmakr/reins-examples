{
  "reins_list_actions": {
    "app": {
      "url": "http://localhost:5173/",
      "title": "Payday Invoice Studio — Lucid Billing Desk (reins + Vite + React)",
      "meta": {
        "app": "payday-invoice-studio",
        "framework": "vite-react"
      }
    },
    "actions": [
      {
        "name": "login-as-tester",
        "description": "Sign in as a seeded dev tester (finance-admin or viewer) and sync /api/invoices",
        "input": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "finance-admin",
                "viewer"
              ]
            }
          }
        },
        "consequential": false,
        "readOnly": false
      },
      {
        "name": "set-locale",
        "description": "Switch the UI locale (en LTR, ar RTL, or fr LTR)",
        "input": {
          "type": "object",
          "properties": {
            "locale": {
              "type": "string",
              "enum": [
                "en",
                "ar",
                "fr"
              ]
            }
          },
          "required": [
            "locale"
          ]
        },
        "consequential": false,
        "readOnly": false
      },
      {
        "name": "set-theme",
        "description": "Switch between light and dark themes",
        "input": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string",
              "enum": [
                "light",
                "dark"
              ]
            }
          },
          "required": [
            "theme"
          ]
        },
        "consequential": false,
        "readOnly": false
      },
      {
        "name": "filter-invoices",
        "description": "Filter invoices by status (all, pending, paid, overdue) and optional search query",
        "input": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "all",
                "pending",
                "paid",
                "overdue"
              ]
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "status"
          ]
        },
        "consequential": false,
        "readOnly": true
      },
      {
        "name": "mark-invoice-paid",
        "description": "Mark a single invoice as paid via POST /api/invoices/:id/pay",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Invoice ID such as INV-1042"
            }
          },
          "required": [
            "id"
          ]
        },
        "consequential": false,
        "readOnly": false
      },
      {
        "name": "void-overdue-invoices",
        "description": "Write off and void all overdue invoices (consequential; requires confirm: true)",
        "input": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          }
        },
        "consequential": true,
        "readOnly": false
      }
    ],
    "states": [
      "app",
      "route",
      "location",
      "localStorage",
      "sessionStorage",
      "cookies"
    ],
    "panels": [
      "header",
      "perf-hud",
      "summary-cards",
      "invoice-list",
      "activity-log"
    ],
    "servers": [
      {
        "client": 1,
        "title": "payday-api",
        "meta": {
          "name": "payday-api",
          "service": "invoices",
          "platform": "node",
          "runtime": "v22.22.0"
        },
        "actions": [
          {
            "name": "get-db-query-mode",
            "description": "Inspect whether /api/invoices uses the unbatched N+1 query (n+1-slow) or batched IN (...) query (batched-fast)",
            "input": {
              "type": "object",
              "properties": {}
            },
            "consequential": false,
            "readOnly": true
          },
          {
            "name": "set-db-query-mode",
            "description": "Switch /api/invoices between the N+1 slow query (n+1-slow) and the batched query fix (batched-fast)",
            "input": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "n+1-slow",
                    "batched-fast"
                  ]
                }
              },
              "required": [
                "mode"
              ]
            },
            "consequential": false,
            "readOnly": false
          },
          {
            "name": "reset-server-metrics",
            "description": "Clear recorded server request/span ring buffers before capturing a fresh post-fix session report",
            "input": {
              "type": "object",
              "properties": {}
            },
            "consequential": false,
            "readOnly": false
          }
        ]
      }
    ]
  },
